# test to execute all macro files

fmt %02.0f
do n 1 33
  if [n]==07 | [n]==13 | [n]==17
    exe doc/macro/ex[n]a.tip
    wait 1
    exe doc/macro/ex[n]b.tip
  elif 23 <= [n] <= 26
    continue
  else
    exe doc/macro/ex[n].tip
  fi
  wait 1
end

# remvoe temporary data
sys rm -f mesh.dat mandelbrot.dat
